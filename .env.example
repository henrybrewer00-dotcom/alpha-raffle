# Required. From `npx -y @insforge/cli current` and `secrets get ANON_KEY`.
VITE_INSFORGE_URL=
VITE_INSFORGE_ANON_KEY=

# Optional. Change these to stand this up at another school.
VITE_SCHOOL_NAME=Alpha High School
VITE_SCHOOL_SHORT=ALPHA HIGH
VITE_SCHOOL_CITY=Austin
VITE_EMAIL_DOMAIN=alpha.school

# Seed / admin scripts only. Never commit this.
# INSFORGE_API_KEY=
# EMAIL_DOMAIN=alpha.school

